{
  "kind": "adventure",
  "schema_version": 3,
  "engine_version": "1.6.0",
  "payload": {
    "name": "The Hollow Tithe",
    "description": "A river toll-keep, bricked up and forgotten under a landing town, where the quarterly count was collected, counted, and never sent on.",
    "hooks": [
      "The reeve of Thistlereach will pay in coin for the toll-keep's ledger, and pay again for a plain account of what became of the clerk who kept it.",
      "Rats the size of hounds have been coming up the drains for a season. Something below was opened, and the town would very much like it shut again.",
      "A barge crew swears they heard a hand-bell ringing under the bank at slack tide. Nobody has rung the tithe bell since the keeps were sealed."
    ],
    "town": {
      "name": "Thistlereach",
      "description": "A landing town of pitch-black timber and grey thatch, strung along one bend of a slow river. It grew up around the toll it collected and has been quietly shrinking ever since the toll stopped. The reeve keeps a lamp burning on the quay for anyone coming back up the cut after dark.",
      "services": [
        "The Wet Rope: beds, baths, and a locked chest for the night, paid in advance.",
        "Halder's counter: rope, oil, iron spikes, and lamp wick sold by the bundle.",
        "The bonesetter's bench behind the chapel: splints, poultices, and prayers, priced by the wound."
      ],
      "travel_turns": {
        "hollow-tithe": 2
      }
    },
