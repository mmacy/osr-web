# osr-web configuration — copy to .env and edit.
# Values here fill in whatever the process environment doesn't already set.

# --- LLM narration (optional; off when OSR_WEB_NARRATOR is unset) ---

# Provider id. Only "ollama" is supported today.
#OSR_WEB_NARRATOR=ollama

# Model name as the provider knows it. Required when a provider is set.
#OSR_WEB_NARRATOR_MODEL=llama3.2

# Provider base URL. Default for ollama: http://localhost:11434
#OSR_WEB_NARRATOR_URL=http://localhost:11434

# API key for hosted providers; ignored by ollama.
#OSR_WEB_NARRATOR_API_KEY=

# Per-passage generation timeout in seconds. Default: 30
#OSR_WEB_NARRATOR_TIMEOUT=30

# --- Adventure library ---

# Replace the bundled adventure document.
#OSR_WEB_ADVENTURE=/path/to/adventure.json

# Extra adventure files or directories to scan, colon-separated. Appends to the
# scan; the drop directory below stays in place.
#OSR_WEB_ADVENTURES=/path/one:/path/two

# Replace the adventures/ drop directory (not the same thing as the list above).
#OSR_WEB_ADVENTURES_DIR=/path/to/adventures

# --- Saves ---

# Replace the saves/ directory that saves are written to and listed from.
#OSR_WEB_SAVES_DIR=/path/to/saves
